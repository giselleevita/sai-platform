# Copy to .env on the deployment host. Compose reads it.

# The API refuses to start in production without a real value.
JWT_SECRET=

# Origin the browser uses. Becomes CORS_ORIGIN for the API.
PUBLIC_URL=http://localhost:3000

# Database. Postgres only: Prisma has no Oracle connector.
POSTGRES_USER=sai_user
POSTGRES_PASSWORD=
POSTGRES_DB=sai_db
DATABASE_URL=postgresql://sai_user:password@postgres:5432/sai_db

# Read by the seed when it creates the demo tenant.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Shown on the login page. Build-time: changing them needs a rebuild.
# Leave unset outside a demo and the credentials block does not render.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# Where the web app proxies /api and /scim. Build-time.
API_ORIGIN=http://api:3001
